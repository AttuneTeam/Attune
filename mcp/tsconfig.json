{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "..",
    "paths": {
      "@modelcontextprotocol/sdk/server/mcp": [
        "node_modules/@modelcontextprotocol/sdk/dist/cjs/server/mcp"
      ],
      "@modelcontextprotocol/sdk/server/stdio": [
        "node_modules/@modelcontextprotocol/sdk/dist/cjs/server/stdio"
      ]
    }
  },
  "include": ["server.ts"]
}
